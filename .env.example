# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Portable local storage ----
# Keep large reviewed bundles and checkpoints outside Git. A machine running a
# clone may use a mounted volume by overriding these values in its private .env.
DATA_ROOT=./data
ARTIFACT_ROOT=./data/artifacts
CHECKPOINT_ROOT=./data/checkpoints
RUNS_ROOT=./runs

# Credential-free 2D smoke/demo only: exposes the built-in CPU reference
# detector and the five KITTI samples committed with this repository. It does
# not claim to provide a reviewed YOLO model or the 100-sample catalog.
BOOTSTRAP_PORTABLE_DEMO=false

# ---- Artifact object storage (required for durable Render artifacts) ----
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=advertest-artifacts
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Security & Authentication ----
JWT_SECRET=your-secure-random-32-character-secret-key-here
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Demo-only sign-in. Set to true ONLY for a public demo deployment: seeds and
# exposes one-click login cards for engineer@advertest.ai + admin@advertest.ai
# on the sign-in page (their passwords become public by design). Keep false in
# a hardened production deployment.
DEMO_BOOTSTRAP_ACCOUNTS=false
DEMO_ENGINEER_PASSWORD=EngineerPassword123!

# ---- AI Hook Logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
# API_PROXY_TARGET=http://127.0.0.1:8000
